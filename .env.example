# TrueNAS Scale
TRUENAS_URL=https://192.168.1.x        # URL naar jouw TrueNAS (geen trailing slash)
TRUENAS_API_KEY=1-xxxxxxxxxxxxxxxxxxxx  # API key van TrueNAS (read-only user)
TRUENAS_VERIFY_SSL=false               # false = accepteer self-signed certificaat

# Plex Media Server
PLEX_URL=http://192.168.1.x:32400      # URL naar jouw Plex server
PLEX_TOKEN=xxxxxxxxxxxxxxxxxxxx        # Plex token (zie README voor hoe te vinden)

# Analyse instellingen
STALE_MONTHS=6                         # Items niet bekeken in X maanden = stale

# Scan instellingen (optioneel maar sterk aanbevolen bij grote NAS)
SCAN_PATHS=/mnt/Media,/mnt/Movies      # Kommagescheiden paden om te scannen (leeg = alles)
NAS_CONCURRENCY=20                     # Aantal gelijktijdige API-calls naar TrueNAS

# Cache instellingen
CACHE_TTL_HOURS=24                     # Hoe lang schijfcache geldig is (0 = altijd herladen)
